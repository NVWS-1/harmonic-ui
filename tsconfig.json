{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",

    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",

    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
